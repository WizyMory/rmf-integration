[Unit]
Description=BRIN RMF Web API (real time)
Requires=brin-rmf-network.service
After=brin-rmf-network.service
PartOf=brin-rmf.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/rmf-integration
ExecStart=/usr/bin/bash %h/rmf-integration/main/bringup.bash api
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
