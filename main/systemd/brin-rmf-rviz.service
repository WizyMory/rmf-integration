[Unit]
Description=BRIN RMF RViz on the local desktop
Requires=brin-rmf-core.service
After=graphical-session.target brin-rmf-core.service
PartOf=graphical-session.target brin-rmf.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/rmf-integration
ExecStart=/usr/bin/bash %h/rmf-integration/main/bringup.bash rviz
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
