Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
    Background Color: 48; 48; 48
  Displays:
  - Class: rviz_default_plugins/Map
    Name: BRIN occupancy
    Enabled: true
    Topic:
      Value: /map
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    Alpha: 0.7
  - Class: rviz_default_plugins/MarkerArray
    Name: RMF scheduled traffic
    Enabled: true
    Topic:
      Value: /schedule_markers
      Depth: 10
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: RMF fleet positions
    Enabled: true
    Topic:
      Value: /fleet_markers
      Depth: 10
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/TF
    Name: Robot TF trees
    Enabled: false
    Show Names: false
    Show Axes: true
    Marker Scale: 0.3
  - Class: rviz_default_plugins/RobotModel
    Name: husky_0
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /husky_0/robot_description
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    TF Prefix: husky_0
  - Class: rviz_default_plugins/LaserScan
    Name: husky_0 Ouster
    Enabled: false
    Topic:
      Value: /husky_0/sensors/lidar3d_0/scan
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
    Size (m): 0.025
    Color: 40; 160; 255
    Queue Size: 1
    Decay Time: 0
  - Class: rviz_default_plugins/PoseArray
    Name: husky_0 AMCL particles
    Enabled: false
    Topic:
      Value: /husky_0/particlecloud
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Color: 40; 160; 255
  - Class: rviz_default_plugins/Path
    Name: husky_0 global plan
    Enabled: true
    Topic:
      Value: /husky_0/plan
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Color: 40; 160; 255
    Line Width: 0.05
  - Class: rviz_default_plugins/Path
    Name: husky_0 local plan
    Enabled: true
    Topic:
      Value: /husky_0/local_plan
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Color: 40; 160; 255
    Line Width: 0.05
  - Class: rviz_default_plugins/Map
    Name: husky_0 global costmap
    Enabled: false
    Topic:
      Value: /husky_0/global_costmap/costmap
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    Color Scheme: costmap
    Alpha: 0.4
  - Class: rviz_default_plugins/Map
    Name: husky_0 local costmap
    Enabled: false
    Topic:
      Value: /husky_0/local_costmap/costmap
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    Color Scheme: costmap
    Alpha: 0.4
  - Class: rviz_default_plugins/RobotModel
    Name: husky_1
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /husky_1/robot_description
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    TF Prefix: husky_1
  - Class: rviz_default_plugins/LaserScan
    Name: husky_1 Ouster
    Enabled: false
    Topic:
      Value: /husky_1/sensors/lidar3d_0/scan
