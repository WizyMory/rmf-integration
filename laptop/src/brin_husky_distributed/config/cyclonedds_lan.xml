<?xml version="1.0" encoding="UTF-8"?>
<!-- Integration processes only. Review interface/peer if the LAN changes. -->
<CycloneDDS>
  <Domain>
    <General>
      <Interfaces><NetworkInterface name="wlp9s0"/></Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>40</MaxAutoParticipantIndex>
      <Peers><Peer Address="192.168.0.120"/><Peer Address="192.168.0.237"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
