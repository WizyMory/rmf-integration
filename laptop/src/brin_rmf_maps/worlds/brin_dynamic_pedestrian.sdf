    <!-- Dynamic pedestrian crossing RMF lanes near (29.5, -32.6).
         Fortress actors are visual only. The follower system synchronizes a
         separate physics collision cylinder with this actor every sim step.
         Fuel supplies walk.dae on first use. -->
    <actor name="pedestrian_crossing_01">
      <pose>28.2 -32.65 0 0 0 0</pose>
      <skin>
        <filename>https://fuel.ignitionrobotics.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.ignitionrobotics.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>0 0 1 0 0 0</pose></waypoint>
          <waypoint><time>4</time><pose>2.4 0 1 0 0 0</pose></waypoint>
          <waypoint><time>5</time><pose>2.4 0 1 0 0 3.14159</pose></waypoint>
          <waypoint><time>9</time><pose>0 0 1 0 0 3.14159</pose></waypoint>
          <waypoint><time>10</time><pose>0 0 1 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>
    <model name="pedestrian_crossing_01_collision">
      <static>true</static>
      <pose>28.2 -32.65 0 0 0 0</pose>
      <link name="body">
        <collision name="human_body">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.28</radius><length>1.6</length></cylinder>
          </geometry>
        </collision>
      </link>
    </model>
    <plugin filename="libbrin_actor_collision_follower.so"
            name="brin_rmf_maps::ActorCollisionFollower">
      <actor_name>pedestrian_crossing_01</actor_name>
      <collision_model_name>pedestrian_crossing_01_collision</collision_model_name>
      <z_offset>-1.0</z_offset>
    </plugin>
  </world>
</sdf>
